   "source": [
    "# 4.6 Genero principal de las 20 peliculas mas recientes\n",
    "last_20_movies = movies_df.sort_values(by='releaseYear', ascending=False).head(20)\n",
    "primary_genres = last_20_movies['genres'].str.split('|').str[0].fillna('No genre')\n",
    "print(primary_genres.value_counts())\n",
    "print(\"El gnero principal de las 20 peliculas mas recientes es: \", primary_genres.value_counts().idxmax())"
   ]
  },
